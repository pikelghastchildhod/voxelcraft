            cursor: pointer; pointer-events: auto; z-index: 100;
        }
        #quick-save-btn:active { background: #333; transform: scale(0.95); }

        .stat-row { display: flex; justify-content: space-between; padding: 0 10px; }
        .stat-bar { display: flex; }
        
        /* OFFICIAL GUI SPRITES */
        .mc-icon {
            width: 18px; height: 18px;
            background-image: url('https://raw.githubusercontent.com/InventivetalentDev/minecraft-assets/1.20.1/assets/minecraft/textures/gui/icons.png');
