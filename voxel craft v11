        #cinema-bottom { bottom: 0; }
        
        .hidden { display: none !important; }
        
        /* UI Modals */
        .modal-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85); z-index: 250;
