        #achievement-toast.show { top: 20px; }
        .ach-icon { font-size: 2rem; }
        .ach-text-sm { font-size: 0.7rem; color: #ffaa00; font-weight: bold; text-transform: uppercase;}
        .ach-title { font-size: 1.1rem; font-weight: bold; }

        /* Achievements Menu Grid */
        .ach-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 10px; }
        .ach-card { 
            background: #444; border: 2px solid #666; padding: 10px; display: flex; gap: 10px; align-items: center; 
        }
        .ach-card.unlocked { border-color: #ffaa00; background: #5a4a2a; }
        .ach-card.locked { opacity: 0.5; filter: grayscale(100%); }
        .ach-card-icon { font-size: 2rem; }
        .ach-card-info h4 { margin: 0; color: #ffaa00; font-size: 1rem; }
        .ach-card-info p { margin: 0; color: #ccc; font-size: 0.75rem; }
    </style>
</head>
<body>

    <div id="achievement-toast">
        <div class="ach-icon" id="toast-icon">🏆</div>
        <div>
            <div class="ach-text-sm">Achievement Unlocked!</div>
            <div class="ach-title" id="toast-title">Getting Wood</div>
        </div>
    </div>

    <div id="cinema-top" class="cinema-bar"></div>
    <div id="cinema-bottom" class="cinema-bar"></div>
    <div id="lightning-flash"></div>

    <div id="loading">
        <h2 class="text-3xl font-bold mb-4">GENERATING BIOMES...</h2>
        <div class="w-72 h-4 bg-gray-900 border-2 border-gray-600 p-1">
            <div id="progress" class="h-full bg-pink-400 w-0 transition-all duration-100"></div>
        </div>
    </div>

    <!-- DAMAGE AND DEATH OVERLAYS -->
    <div id="damage-overlay" class="hidden" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(255,0,0,0.35);pointer-events:none;z-index:90;transition:opacity 0.15s ease-out;"></div>
    
    <div id="death-screen" class="hidden" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(200,0,0,0.6);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:300;">
        <h1 class="text-6xl font-black text-white italic mb-8 [text-shadow:4px_4px_#444,8px_8px_#000]">YOU DIED</h1>
        <div class="mc-button" onclick="respawnPlayer()">RESPAWN</div>
    </div>

    <!-- UPDATE LOG OVERLAY -->
    <div id="update-log-overlay" class="modal-overlay hidden">
        <div class="modal-container">
            <div class="modal-header">
                <h2 class="text-2xl font-bold text-white tracking-widest italic">UPDATE LOG</h2>
                <p class="text-gray-400 text-xs mt-1">Versioning: Major Updates (v11.0) • Minor/Fixes (v11.1)</p>
            </div>
            <div class="modal-content">
                <div class="log-version text-green-400">v11.2 - Official GUI Update</div>
                <ul class="log-list">
                    <li>Replaced health and hunger bars with Official Minecraft Textures pulled from the 1.20 sprite sheet.</li>
                    <li>Items and blocks now use high-quality 16x16 pixel sprites loaded directly from an external repository.</li>
                    <li>Disabled forced saving when gaining achievements.</li>
                </ul>

                <div class="log-version text-yellow-400">v11.0 - The Achievement Update</div>
                <ul class="log-list">
                    <li>Added a fully functioning Achievements system.</li>
                    <li>Added "ACHIEVEMENTS" menu to view progress and unlocks.</li>
                    <li>Added golden sliding Toast Notifications when earning an achievement.</li>
                </ul>

                <div class="log-version text-purple-400">v10.0 - The Omni-Mod Update</div>
                <ul class="log-list">
                    <li>Expanded AI Mod Maker to support <b>Shaders</b>, <b>Biomes</b>, and <b>Texture Packs</b>!</li>
                </ul>
            </div>
            <div class="modal-footer">
                <div class="mc-button !w-full !m-0 !py-2" onclick="hideModal('update-log-overlay')">CLOSE LOG</div>
            </div>
        </div>
    </div>

    <!-- ACHIEVEMENTS OVERLAY -->
    <div id="achievements-overlay" class="modal-overlay hidden">
        <div class="modal-container">
            <div class="modal-header">
                <h2 class="text-2xl font-bold text-white tracking-widest italic text-yellow-400">ACHIEVEMENTS</h2>
                <p class="text-gray-400 text-xs mt-1">Track your legendary progress!</p>
            </div>
            <div class="modal-content">
                <div id="achievements-grid" class="ach-grid">
                    <!-- Injected via JS -->
                </div>
            </div>
            <div class="modal-footer">
                <div class="mc-button !w-full !m-0 !py-2" onclick="hideModal('achievements-overlay')">CLOSE</div>
            </div>
        </div>
    </div>

    <!-- AI MOD MAKER OVERLAY -->
    <div id="mod-maker-overlay" class="modal-overlay hidden">
        <div class="modal-container">
            <div class="modal-header">
                <h2 class="text-2xl font-bold text-white tracking-widest italic text-blue-300">AI MOD MAKER</h2>
                <p class="text-gray-400 text-xs mt-1">Generate Blocks, Items, Texture Packs, Biomes, or Shaders!</p>
            </div>
            <div class="modal-content">
                <div class="mb-4 pb-4 border-b border-gray-600">
                    <p class="text-gray-300 mb-2 font-bold">Try Pre-Built Mods Instantly:</p>
                    <div class="flex gap-2">
                        <button class="bg-gray-700 hover:bg-gray-600 px-3 py-1 rounded text-xs border border-gray-500" onclick="loadExampleMod('plasma')">Plasma Sword</button>
                        <button class="bg-gray-700 hover:bg-gray-600 px-3 py-1 rounded text-xs border border-gray-500" onclick="loadExampleMod('bloodmoon')">Blood Moon Shader</button>
                        <button class="bg-gray-700 hover:bg-gray-600 px-3 py-1 rounded text-xs border border-gray-500" onclick="loadExampleMod('wasteland')">Wasteland Biome</button>
                    </div>
                </div>

                <p>Mod Type:</p>
                <select id="mod-type-select" class="mod-input mb-2">
                    <option value="BLOCK_ITEM">Block or Item (e.g., Plasma Sword, Crystal Block)</option>
                    <option value="TEXTURE_PACK">Texture Pack (e.g., Hellscape, Candyland)</option>
                    <option value="SHADER">Shader (e.g., Blood Moon, Toxic Fog, Deep Sea)</option>
                    <option value="BIOME">Biome (e.g., Radioactive Wasteland, Crystal Peaks)</option>
                </select>

                <p>Prompt Description:</p>
                <input type="text" id="mod-prompt" class="mod-input" placeholder="Enter your wild idea..." autocomplete="off">
                
                <div id="mod-output-box">Waiting for prompt...</div>
            </div>
            <div class="modal-footer flex-wrap">
                <div id="btn-generate-mod" class="mc-button !m-0 !py-2 !text-sm !bg-blue-600 !border-blue-800 w-full" onclick="generateAIMod()">GENERATE MOD</div>
                <div id="btn-dl-mod" class="mc-button !w-[45%] !m-0 !py-2 !text-sm !bg-green-600 hidden" onclick="downloadModFile()">DOWNLOAD .JSON</div>
                <div id="btn-inst-mod" class="mc-button !w-[45%] !m-0 !py-2 !text-sm !bg-purple-600 hidden" onclick="installGeneratedMod()">INSTALL NOW</div>
                <div class="mc-button !w-full !m-0 !py-2 !text-sm" onclick="hideModal('mod-maker-overlay')">CLOSE</div>
            </div>
        </div>
    </div>

    <!-- MAIN MENU -->
    <div id="menu-overlay" class="hidden">
        <h1 class="text-5xl font-black text-white italic mb-6 [text-shadow:4px_4px_#444,8px_8px_#000]">VOXELCRAFT</h1>
        
        <div class="flex flex-wrap justify-center max-w-[650px] gap-2 mb-4">
            <div class="mc-button" onclick="startGame(false)">START SURVIVAL</div>
            <div class="mc-button" onclick="startGame(true)">START CREATIVE</div>
            
            <div class="mc-button secondary !w-[130px]" onclick="document.getElementById('save-file-input').click()">LOAD SAVE</div>
            <input type="file" id="save-file-input" class="hidden" accept=".json" onchange="loadSaveFile(event)">
            
            <div class="mc-button secondary !w-[130px] !bg-blue-700 !border-blue-900" onclick="showModal('mod-maker-overlay')">AI MOD MAKER</div>
            
            <div class="mc-button secondary !w-[130px] !bg-purple-700 !border-purple-900" onclick="document.getElementById('mod-file-input').click()">INSTALL MOD</div>
            <input type="file" id="mod-file-input" class="hidden" accept=".json" onchange="loadModFile(event)">
            
            <div class="mc-button secondary !w-[130px] !bg-yellow-600 !border-yellow-800" onclick="openAchievements()">ACHIEVEMENTS</div>
        </div>

        <div class="flex gap-4">
            <div class="mc-button secondary !w-auto px-6" onclick="showModal('update-log-overlay')">UPDATE LOG (v11.2)</div>
            <div id="mobile-toggle" class="mc-button secondary !w-auto px-6" onclick="toggleMobileMode()">MOBILE: OFF</div>
        </div>
    </div>

    <!-- CRAFTING AND BACKPACK -->
    <div id="crafting-menu" class="hidden">
        <div class="col-span-3 text-center font-bold mb-1 text-black">CRAFTING & BACKPACK</div>
        <div class="craft-tabs">
            <div class="craft-tab active" onclick="setCraftTab('BASIC')">BASIC</div>
            <div class="craft-tab" onclick="setCraftTab('WOOD')">WOOD</div>
            <div class="craft-tab" onclick="setCraftTab('STONE')">STONE</div>
            <div class="craft-tab" onclick="setCraftTab('IRON')">IRON</div>
            <div class="craft-tab" onclick="setCraftTab('MAGIC')" style="color:#ffbbbb;">MAGIC</div>
        </div>
        <div id="crafting-items"></div>
        
        <div class="col-span-3 text-center font-bold mt-1 text-black border-t-2 border-gray-500 pt-1 text-xs">BACKPACK (Click to Swap)</div>
        <div id="full-inventory-grid" class="col-span-3 flex flex-wrap justify-center gap-1 bg-gray-800 p-1 border-2 border-gray-900 rounded"></div>

        <div id="advisor-box" class="col-span-3 mt-1 p-1 hidden" style="background: #222; border: 2px solid #555; color: #ffaa00; text-shadow: 1px 1px #000; font-size: 10px; text-align: center; min-height: 35px; display: flex; align-items: center; justify-content: center;"></div>
        
        <div class="col-span-3 flex justify-between gap-2 mt-1">
            <div class="mc-button !w-1/2 !py-2 !text-sm !bg-purple-700 !border-purple-900 !m-0" style="color: #e9d5ff;" onclick="askMysticAdvisor()">✨ Ask Advisor</div>
            <div class="mc-button !w-1/2 !py-2 !text-sm !m-0" onclick="toggleCrafting()">CLOSE</div>
        </div>
    </div>

    <!-- GAME UI HUD -->
    <div id="ui" class="hidden">
        <div id="quick-save-btn" onclick="downloadSave()">SAVE</div>
        <div id="day-clock">Day 1</div>
        <div id="crosshair"></div>
        <div id="break-indicator"><div id="break-progress"></div></div>
        <div id="hud">
            <div class="stat-row">
                <div id="health-bar" class="stat-bar"></div>
                <div id="hunger-bar" class="stat-bar"></div>
            </div>
        </div>
        <div id="inventory"></div>
        <div id="mobile-controls">
            <div id="joystick-area"><div id="joystick-container"><div id="joystick-knob"></div></div></div>
            <div class="flex flex-col gap-4">
                <div class="flex gap-4">
                    <div class="touch-btn hidden eat-btn" id="btn-eat">EAT</div>
                    <div class="touch-btn" id="btn-place">PLACE</div>
                    <div class="touch-btn" id="btn-mine">MINE</div>
                </div>
                <div class="flex gap-4 justify-end">
                    <div class="touch-btn inv-btn" id="btn-inv">INV</div>
                    <div class="touch-btn" id="btn-jump">JUMP</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Game Constants
        const CHUNK_SIZE = 16;
        const RENDER_DISTANCE = 3; 
        const BLOCK_TYPES = { 
            AIR: 0, GRASS: 1, DIRT: 2, STONE: 3, WOOD: 4, 
            LEAVES: 5, GLASS: 6, PLANKS: 7, TABLE: 8, 
            STICK: 9, PICKAXE: 10, SWORD: 11,
            SAND: 12, CACTUS: 13, SANDSTONE: 14,
            JUNGLE_WOOD: 15, JUNGLE_LEAVES: 16, JUNGLE_GRASS: 17,
            CHERRY_WOOD: 18, CHERRY_LEAVES: 19, CHERRY_GRASS: 20,
            CHICKEN_MEAT: 21, CAMEL_MEAT: 22, AXE: 23, SNOW: 24,
            IRON_ORE: 25, IRON_INGOT: 26, 
            STONE_SWORD: 27, STONE_PICKAXE: 28, STONE_AXE: 29,
            IRON_SWORD: 30, IRON_PICKAXE: 31, IRON_AXE: 32,
            RITUAL: 33, BRASS_KNUCKLES: 34
        };
        
        const COLORS = {
            GRASS: ['#5da130', '#4a8226', '#3d6b20'],
            JUNGLE_GRASS: ['#2e7d32', '#1b5e20', '#0a3d0d'],
            CHERRY_GRASS: ['#df7eb3', '#c16196', '#9c4c77'],
            DIRT: ['#79553a', '#61442e', '#4d3625'],
            STONE: ['#888888', '#777777', '#666666'],
            IRON_ORE: ['#888888', '#e2c0a5', '#666666'],
            WOOD: ['#5d3a1a', '#4a2e15', '#382310'],
