            constructor(x, y, z) {
                this.group = new THREE.Group();
                this.pos = new THREE.Vector3(x, y, z);
                this.vel = new THREE.Vector3(0, 0, 0);
                this.rotation = Math.random() * Math.PI * 2;
                
                const skinMat = new THREE.MeshLambertMaterial({color: 0xe8c396}); 
                const darkMat = new THREE.MeshLambertMaterial({color: 0xa06535}); 
                const noseMat = new THREE.MeshLambertMaterial({color: 0xc89f74}); 
                const eyeMat = new THREE.MeshLambertMaterial({color: 0x222222});  

                this.bodyGroup = new THREE.Group();
                this.bodyGroup.position.set(0, 0.95, 0); 
                
                const body = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.7, 1.1), skinMat);
                const hump = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.3, 0.5), darkMat); hump.position.set(0, 0.5, 0);
                
                const tailGroup = new THREE.Group(); tailGroup.position.set(0, 0, -0.55); 
                const tail = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.3, 0.1), darkMat); tail.position.set(0, -0.15, -0.05); 
                tailGroup.add(tail); this.tail = tailGroup;

                const neckGroup = new THREE.Group(); neckGroup.position.set(0, 0, 0.55); 
                const neck = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.5, 0.4), skinMat); neck.position.set(0, 0.25, 0.1);
                const head = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.5, 0.6), skinMat); head.position.set(0, 0.6, 0.2);
                const snout = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.2, 0.2), noseMat); snout.position.set(0, 0.5, 0.5);
                
                const eyeL = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.15, 0.15), eyeMat); eyeL.position.set(0.31, 0.65, 0.3);
                const eyeR = new THREE.Mesh(new THREE.BoxGeometry(0.05, 0.15, 0.15), eyeMat); eyeR.position.set(-0.31, 0.65, 0.3);
                
                this.earL = new THREE.Group(); this.earL.position.set(0.3, 0.8, 0.1);
                const earMeshL = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.15, 0.1), darkMat); earMeshL.position.set(0.05, 0.075, 0); this.earL.add(earMeshL);

                this.earR = new THREE.Group(); this.earR.position.set(-0.3, 0.8, 0.1);
                const earMeshR = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.15, 0.1), darkMat); earMeshR.position.set(-0.05, 0.075, 0); this.earR.add(earMeshR);

                neckGroup.add(neck, head, snout, eyeL, eyeR, this.earL, this.earR);
                this.neck = neckGroup;

                this.bodyGroup.add(body, hump, tailGroup, neckGroup);
                this.group.add(this.bodyGroup);

                this.legs = [];
                for (let i = 0; i < 4; i++) {
                    const legGroup = new THREE.Group();
                    const xOff = (i % 2 === 0 ? 1 : -1) * 0.3;
                    const zOff = (i < 2 ? 1 : -1) * 0.4;
                    legGroup.position.set(xOff, 0.6, zOff); 
                    const leg = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.6, 0.25), skinMat); leg.position.set(0, -0.3, 0); 
                    const hoof = new THREE.Mesh(new THREE.BoxGeometry(0.26, 0.15, 0.26), darkMat); hoof.position.set(0, -0.55, 0); 
                    legGroup.add(leg, hoof); this.legs.push(legGroup); this.group.add(legGroup);
                }
                
                this.group.userData.entity = this;
                mobsParent.add(this.group);
                
                this.aiState = 'WANDER';
                this.stateTimer = 0;
                this.moveSpeed = 0.035;
                this.isDead = false;
                this.hp = 10;
                this.lastHurt = 0;
                this.walkCycle = 0;
            }

            takeDamage(amount = 1) {
                if (this.isDead || performance.now() - this.lastHurt < 500) return;
                this.hp -= amount;
                this.lastHurt = performance.now();
                this.vel.y = 0.2;
                if (this.hp <= 0) {
                    this.isDead = true;
                    mobsParent.remove(this.group);
                    if (!isCreative) {
                        spawnDrop(this.pos.x, this.pos.y, this.pos.z, BLOCK_TYPES.CAMEL_MEAT);
                        spawnDrop(this.pos.x, this.pos.y + 0.5, this.pos.z, BLOCK_TYPES.CAMEL_MEAT);
                        spawnDrop(this.pos.x + 0.5, this.pos.y, this.pos.z, BLOCK_TYPES.CAMEL_MEAT);
                    }
                }
            }

            update(dt = 1) {
                if (this.isDead) return;
                
                if (this.aiState === 'FLEE' && bossEntity) {
                    const dx = this.pos.x - bossEntity.pos.x;
                    const dz = this.pos.z - bossEntity.pos.z;
                    this.rotation = Math.atan2(dx, dz);
                    this.moveSpeed = 0.12; 
                } else {
                    this.moveSpeed = 0.035;
                    this.stateTimer -= dt;
                    if (Math.random() < 0.02 * dt) {
                        this.earL.rotation.z = -0.3 + Math.random() * 0.1;
                        this.earR.rotation.z = 0.3 - Math.random() * 0.1;
                    } else {
                        this.earL.rotation.z *= Math.pow(0.8, dt);
                        this.earR.rotation.z *= Math.pow(0.8, dt);
                    }

                    if (this.stateTimer <= 0) {
                        const r = Math.random();
                        if (r < 0.6) {
                            this.aiState = 'WANDER';
                            this.rotation = Math.random() * Math.PI * 2;
                            this.stateTimer = 100 + Math.random() * 200;
                        } else {
                            this.aiState = 'IDLE';
                            this.stateTimer = 50 + Math.random() * 100;
                        }
                    }
                }
                
                if (this.aiState === 'WANDER' || this.aiState === 'FLEE') {
                    const dx = Math.sin(this.rotation) * this.moveSpeed * dt;
                    const dz = Math.cos(this.rotation) * this.moveSpeed * dt;
                    const nextPos = this.pos.clone().add(new THREE.Vector3(dx, 0, dz));
                    
                    if (!isSolid(nextPos.x, nextPos.y, nextPos.z) && 
                        !isSolid(nextPos.x, nextPos.y + 1, nextPos.z) && 
                        !isSolid(nextPos.x, nextPos.y + 2, nextPos.z)) {
                        this.pos.x = nextPos.x;
                        this.pos.z = nextPos.z;
                        
                        this.walkCycle += (this.aiState==='FLEE'? 0.4 : 0.2) * dt;
                        
                        this.bodyGroup.position.y = 0.95 + Math.abs(Math.sin(this.walkCycle)) * 0.05;
                        this.tail.rotation.z = Math.sin(this.walkCycle * 2) * 0.2;

                        this.legs[0].rotation.x = Math.sin(this.walkCycle) * 0.5;
                        this.legs[1].rotation.x = Math.sin(this.walkCycle + Math.PI) * 0.5;
                        this.legs[2].rotation.x = Math.sin(this.walkCycle + Math.PI) * 0.5;
                        this.legs[3].rotation.x = Math.sin(this.walkCycle) * 0.5;
                    } else {
                        if (this.aiState !== 'FLEE') { this.rotation += Math.PI; this.stateTimer = 20; }
                    }
                    this.neck.rotation.x = Math.sin(this.walkCycle * 0.5) * 0.05;
                } else {
                    this.legs.forEach(l => l.rotation.x = 0);
                    this.neck.rotation.x = 0;
                    this.bodyGroup.position.y = 0.95;
                    this.tail.rotation.z = 0;
                }
                
                this.vel.y -= 0.01 * dt;
                this.pos.y += this.vel.y * dt;
                if (isSolid(this.pos.x, this.pos.y, this.pos.z)) {
                    this.pos.y = Math.ceil(this.pos.y);
                    this.vel.y = 0;
                    const fX = this.pos.x + Math.sin(this.rotation) * 1.0;
                    const fZ = this.pos.z + Math.cos(this.rotation) * 1.0;
                    if (isSolid(fX, this.pos.y, fZ) && !isSolid(fX, this.pos.y + 1, fZ) && !isSolid(fX, this.pos.y + 2, fZ)) {
                        if(this.aiState === 'FLEE') this.vel.y = 0.3; 
                        else this.vel.y = 0.25; 
                    }
                }
                this.group.position.copy(this.pos);
                this.group.rotation.y = this.rotation;
            }
        }

        // Noise and Terrain Helpers
        function lerp(a, b, t) { return a + (b - a) * t; }
        function fade(t) { return t * t * t * (t * (t * 6 - 15) + 10); }
        const p_vals = Array.from({length: 256}, () => Math.floor(Math.random() * 256));
        const permutation = [...p_vals, ...p_vals];
        function noise(x, z) {
            const X = Math.floor(x) & 255; const Z = Math.floor(z) & 255;
            const xf = x - Math.floor(x); const zf = z - Math.floor(z);
            const u = fade(xf); const v = fade(zf);
            const aa = permutation[permutation[X] + Z];
            const ab = permutation[permutation[X] + Z + 1];
            const ba = permutation[permutation[X + 1] + Z];
            const bb = permutation[permutation[X + 1] + Z + 1];
            return lerp(lerp(aa / 255, ba / 255, u), lerp(ab / 255, bb / 255, u), v);
        }

        function generateBlockTexture(type, side) {
            const size = 16;
            const canvas = document.createElement('canvas'); canvas.width = size; canvas.height = size;
            const ctx = canvas.getContext('2d');
            let palette = COLORS.STONE;
            const typeName = Object.keys(BLOCK_TYPES).find(k => BLOCK_TYPES[k] === type);
            
            if (MOD_DATA[type] && MOD_DATA[type].colors) palette = MOD_DATA[type].colors;
            else if (type === BLOCK_TYPES.GRASS) palette = (side === 'top' ? COLORS.GRASS : COLORS.DIRT);
            else if (type === BLOCK_TYPES.JUNGLE_GRASS) palette = (side === 'top' ? COLORS.JUNGLE_GRASS : COLORS.DIRT);
            else if (type === BLOCK_TYPES.CHERRY_GRASS) palette = (side === 'top' ? COLORS.CHERRY_GRASS : COLORS.DIRT);
            else if (COLORS[typeName]) palette = COLORS[typeName];
            
            if ((type === BLOCK_TYPES.WOOD || type === BLOCK_TYPES.JUNGLE_WOOD) && (side === 'top' || side === 'bottom')) palette = COLORS.WOOD_TOP;
            if (type === BLOCK_TYPES.CHERRY_WOOD && (side === 'top' || side === 'bottom')) palette = COLORS.CHERRY_TOP;

            ctx.fillStyle = palette[0]; ctx.fillRect(0,0,size,size);
            for(let x=0; x<size; x++) {
                for(let y=0; y<size; y++) {
                    const r = Math.random();
                    if (r > 0.8) { ctx.fillStyle = palette[1]; ctx.fillRect(x,y,1,1); }
                    else if (r < 0.1) { ctx.fillStyle = palette[2]; ctx.fillRect(x,y,1,1); }
                }
            }
            if ((type === BLOCK_TYPES.GRASS || type === BLOCK_TYPES.JUNGLE_GRASS || type === BLOCK_TYPES.CHERRY_GRASS) && side !== 'top' && side !== 'bottom') {
                ctx.fillStyle = (type === BLOCK_TYPES.GRASS ? COLORS.GRASS[0] : type === BLOCK_TYPES.CHERRY_GRASS ? COLORS.CHERRY_GRASS[0] : COLORS.JUNGLE_GRASS[0]); 
                ctx.fillRect(0,0,size,4);
                for(let x=0; x<size; x++) { ctx.fillRect(x, 0, 1, 4 + Math.floor(Math.random()*3)); }
            }
            if (type === BLOCK_TYPES.CACTUS) {
                ctx.fillStyle = 'rgba(0,0,0,0.3)';
                for(let i=0; i<size; i+=4) ctx.fillRect(i, 0, 1, size);
                for(let i=0; i<size; i+=4) ctx.fillRect(0, i, size, 1);
            }
            ctx.fillStyle = 'rgba(255,255,255,0.1)'; ctx.fillRect(0,0,size,1); ctx.fillRect(0,0,1,size);
            ctx.fillStyle = 'rgba(0,0,0,0.1)'; ctx.fillRect(0,size-1,size,1); ctx.fillRect(size-1,0,1,size);
            if (side === 'side' || side === 'top') if (!inventoryTextures[type]) inventoryTextures[type] = canvas.toDataURL();
            const tex = new THREE.CanvasTexture(canvas);
            tex.magFilter = THREE.NearestFilter; tex.minFilter = THREE.NearestFilter;
            return tex;
        }

        function generateItemTexture(type) {
            if (inventoryTextures[type]) return inventoryTextures[type];
            const size = 16;
            const canvas = document.createElement('canvas'); canvas.width = size; canvas.height = size;
            const ctx = canvas.getContext('2d');

            let spriteData = ITEM_SPRITES[type];
            if (MOD_DATA[type] && MOD_DATA[type].isItem) spriteData = { art: MOD_DATA[type].art, pal: MOD_DATA[type].pal };

            if (spriteData && spriteData.art) {
                for(let y=0; y<16 && y<spriteData.art.length; y++) {
                    for(let x=0; x<16 && x<spriteData.art[y].length; x++) {
                        const char = spriteData.art[y][x];
                        if(spriteData.pal[char]) {
                            ctx.fillStyle = spriteData.pal[char];
                            ctx.fillRect(x, y, 1, 1);
                        }
                    }
                }
            }
            
            inventoryTextures[type] = canvas.toDataURL();
            const tex = new THREE.CanvasTexture(canvas);
            tex.magFilter = THREE.NearestFilter; tex.minFilter = THREE.NearestFilter;
            return tex;
        }

        function getMaterials(type) {
            if (materials[type]) return materials[type];
            
            const isTransparent = [BLOCK_TYPES.LEAVES, BLOCK_TYPES.JUNGLE_LEAVES, BLOCK_TYPES.CHERRY_LEAVES, BLOCK_TYPES.CACTUS, BLOCK_TYPES.GLASS].includes(type);

            if (EXTERNAL_TEXTURES[type] && !MOD_DATA[type] && !activeTexturePack) {
                const urls = EXTERNAL_TEXTURES[type];
                const getMat = (sideKey) => {
                    let file = urls[sideKey] || urls.side || urls.all;
                    let matColor = 0xffffff;
                    if (sideKey === 'top' && urls.colorTop) matColor = urls.colorTop;
                    if (urls.colorAll) matColor = urls.colorAll;

                    if (file) {
                        const tex = loadExternalTexture(TEXTURE_BASE_URL + file);
                        return new THREE.MeshLambertMaterial({ map: tex, color: matColor, transparent: isTransparent, alphaTest: 0.5 });
                    }
                    return new THREE.MeshLambertMaterial({ map: generateBlockTexture(type, sideKey), transparent: isTransparent, alphaTest: 0.5 });
                };
                
                return materials[type] = [
                    getMat('side'), getMat('side'), getMat('top'), getMat('bottom'), getMat('front'), getMat('back')
                ];
            }

            const sides = ['side', 'side', 'top', 'bottom', 'side', 'side'];
            return materials[type] = sides.map(s => new THREE.MeshLambertMaterial({ map: generateBlockTexture(type, s), transparent: isTransparent, alphaTest: 0.5 }));
        }

        function getItemMaterial(type) {
            if (itemMaterials[type]) return itemMaterials[type];
            
            if (EXTERNAL_ITEMS[type] && !MOD_DATA[type]) {
                const tex = loadExternalTexture(ITEM_BASE_URL + EXTERNAL_ITEMS[type]);
                return itemMaterials[type] = new THREE.MeshLambertMaterial({ map: tex, transparent: true, side: THREE.DoubleSide, alphaTest: 0.5 });
            }

            const tex = generateItemTexture(type);
            return itemMaterials[type] = new THREE.MeshLambertMaterial({ map: tex, transparent: true, side: THREE.DoubleSide, alphaTest: 0.5 });
        }

        function getInventoryIconStyle(type) {
            if (EXTERNAL_TEXTURES[type] && !MOD_DATA[type] && !activeTexturePack) {
                const urls = EXTERNAL_TEXTURES[type];
                let file = urls.front || urls.side || urls.all;
                return `background-image:url(${TEXTURE_BASE_URL + file}); background-size: cover; image-rendering: pixelated;`;
            } else if (EXTERNAL_ITEMS[type] && !MOD_DATA[type]) {
                return `background-image:url(${ITEM_BASE_URL + EXTERNAL_ITEMS[type]}); background-size: cover; image-rendering: pixelated;`;
            } else {
                const textureData = inventoryTextures[type];
                const typeName = Object.keys(BLOCK_TYPES).find(key => BLOCK_TYPES[key] === type);
                return textureData ? `background-image:url(${textureData})` : `background-color:${COLORS[typeName]?.[0] || '#777'}`;
            }
        }

        function spawnDrop(x, y, z, type) {
            let mesh;
            if (ITEM_SPRITES[type] || (MOD_DATA[type] && MOD_DATA[type].isItem) || EXTERNAL_ITEMS[type]) {
                mesh = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 0.4), getItemMaterial(type));
            } else {
                mesh = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.3, 0.3), getMaterials(type)[0]);
            }
            mesh.position.set(x, y, z);
            scene.add(mesh);
            droppedItems.push({ mesh, type, pos: new THREE.Vector3(x, y, z), vel: new THREE.Vector3(0, 0.15, 0), born: performance.now(), collected: false });
        }

        function handleAttack() {
            if (!isGameStarted || isCraftingOpen || isPlayerDead || isCutscene) return false;
            const ray = new THREE.Raycaster(); ray.setFromCamera(new THREE.Vector2(0,0), camera);
            const mobHit = ray.intersectObjects(mobsParent.children, true)[0];
            if (mobHit && mobHit.distance < 4) {
                let obj = mobHit.object;
                while (obj && !obj.userData.entity && obj.parent) obj = obj.parent;
                if (obj && obj.userData.entity) {
                    const tool = player.inventory[player.selectedIdx]?.type;
                    let damageAmount = 1;
                    if (MOD_DATA[tool] && MOD_DATA[tool].damage) damageAmount = MOD_DATA[tool].damage; 
                    else if (tool === BLOCK_TYPES.SWORD) damageAmount = 2;
                    else if (tool === BLOCK_TYPES.STONE_SWORD) damageAmount = 3;
                    else if (tool === BLOCK_TYPES.IRON_SWORD) damageAmount = 5;
                    else if (tool === BLOCK_TYPES.BRASS_KNUCKLES) damageAmount = 15; 
                    
                    obj.userData.entity.takeDamage(damageAmount);
                    return true;
                }
            }
            return false;
        }

        function initTouch() {
            window.addEventListener('touchstart', (e) => {
                if (!isGameStarted || isPaused || isCraftingOpen || isPlayerDead || isCutscene) return;
                for (let t of e.changedTouches) {
                    if (t.clientX < window.innerWidth / 2 && touchInput.moveId === null) {
                        touchInput.moveId = t.identifier; touchInput.moveStartX = t.clientX; touchInput.moveStartY = t.clientY;
                    } else if (t.clientX >= window.innerWidth / 2 && touchInput.lookId === null) {
                        if (e.target.closest('.touch-btn') || e.target.closest('#inventory') || e.target.closest('#quick-save-btn')) continue;
                        touchInput.lookId = t.identifier; touchInput.lookLastX = t.clientX; touchInput.lookLastY = t.clientY;
                    }
                }
            }, {passive: false});
            window.addEventListener('touchmove', (e) => {
                if (!isGameStarted || isPaused || isCraftingOpen || isPlayerDead || isCutscene) return;
                for (let t of e.changedTouches) {
                    if (t.identifier === touchInput.moveId) {
                        const dx = t.clientX - touchInput.moveStartX, dy = t.clientY - touchInput.moveStartY;
                        const dist = Math.min(40, Math.sqrt(dx*dx + dy*dy)), angle = Math.atan2(dy, dx);
                        touchInput.moveX = (Math.cos(angle) * dist) / 40; touchInput.moveY = (Math.sin(angle) * dist) / 40;
                        document.getElementById('joystick-knob').style.transform = `translate(${touchInput.moveX * 40}px, ${touchInput.moveY * 40}px)`;
                    } else if (t.identifier === touchInput.lookId) {
                        camera.rotation.y -= (t.clientX - touchInput.lookLastX) * 0.007;
                        camera.rotation.x -= (t.clientY - touchInput.lookLastY) * 0.007;
                        camera.rotation.x = Math.max(-Math.PI/2, Math.min(Math.PI/2, camera.rotation.x));
                        touchInput.lookLastX = t.clientX; touchInput.lookLastY = t.clientY;
                    }
                }
            }, {passive: false});
            window.addEventListener('touchend', (e) => {
                for (let t of e.changedTouches) {
                    if (t.identifier === touchInput.moveId) {
                        touchInput.moveId = null; touchInput.moveX = 0; touchInput.moveY = 0;
                        document.getElementById('joystick-knob').style.transform = `translate(0,0)`;
                    } else if (t.identifier === touchInput.lookId) touchInput.lookId = null;
                }
            });
            const bindBtn = (id, key) => {
                const el = document.getElementById(id);
                if (!el) return;
                el.ontouchstart = (e) => { 
                    e.preventDefault(); 
                    if(key==='MINE') { if (!handleAttack()) { isMining = true; miningProgress = 0; } }
                    else if (key==='EAT') { eatMeat(); }
                    else if (key==='INV') { toggleCrafting(); }
                    else { keys[key] = true; if (key === 'Space') handleJumpPress(); }
                };
                el.ontouchend = (e) => { 
                    e.preventDefault(); 
                    if(key==='MINE') { isMining = false; miningProgress = 0; document.getElementById('break-indicator').style.display = 'none'; }
                    else if (key==='PLACE') handleRightClick();
                    else if (key !== 'INV' && key !== 'EAT') keys[key] = false; 
                };
            };
            bindBtn('btn-jump', 'Space'); 
            bindBtn('btn-mine', 'MINE'); 
            bindBtn('btn-place', 'PLACE'); 
            bindBtn('btn-eat', 'EAT'); 
            bindBtn('btn-inv', 'INV');
        }

        const getBlockKey = (x, y, z) => `${Math.floor(x)},${Math.floor(y)},${Math.floor(z)}`;
        const getBlock = (x, y, z) => blocks.get(getBlockKey(x, y, z)) || 0;
        const isSolid = (x, y, z) => { const b = blocks.get(getBlockKey(x, y, z)); return b !== undefined && b !== 0; };

        function checkCollision(pos) {
            const r = 0.35;
            for (let x = -r; x <= r; x += r*2) 
                for (let z = -r; z <= r; z += r*2) 
                    for (let y = 0.1; y <= 1.75; y += 0.8) 
                        if (isSolid(pos.x+x, pos.y-1.75+y, pos.z+z)) return true;
            return false;
        }

        function toggleMobileMode() {
            isMobileMode = !isMobileMode;
            document.getElementById('mobile-toggle').innerText = `MOBILE: ${isMobileMode ? 'ON' : 'OFF'}`;
            document.getElementById('mobile-toggle').classList.toggle('active-mode', isMobileMode);
        }

        function startGame(creative) {
            isGameStarted = true; isCreative = creative;
            document.getElementById('menu-overlay').classList.add('hidden');
            document.getElementById('ui').classList.remove('hidden');
            document.getElementById('mobile-controls').style.display = isMobileMode ? 'flex' : 'none';
            if (isCreative) {
                document.getElementById('hud').classList.add('hidden');
                const types = [1, 3, 18, 25, 31, 30, 32, 21, 33]; 
                types.forEach((t, i) => { if (player.inventory[i]) player.inventory[i] = {type: t, count: Infinity}; });
            } else {
                document.getElementById('hud').classList.remove('hidden');
            }
            if (!isMobileMode) document.body.requestPointerLock?.();
            updateHUD(); updateHotbarUI();
        }

        function updateHUD() {
            if (isCreative) return;
            const hBar = document.getElementById('health-bar');
            const nBar = document.getElementById('hunger-bar');
            hBar.innerHTML = ''; nBar.innerHTML = '';
            for(let i=0; i<10; i++) {
                const h = document.createElement('div'); 
                h.className = `mc-icon heart ${i < player.health ? 'full' : 'empty'}`;
                hBar.appendChild(h);

                const f = document.createElement('div');
                f.className = `mc-icon food ${i < player.hunger ? 'full' : 'empty'}`;
                nBar.appendChild(f);
            }
        }

        function updateHotbarUI() {
            const container = document.getElementById('inventory');
            container.innerHTML = '';
            for (let i = 0; i < 9; i++) {
                const item = player.inventory[i];
                const slot = document.createElement('div');
                slot.className = `slot ${i === player.selectedIdx ? 'active' : ''}`;
                slot.onclick = () => { player.selectedIdx = i; updateHotbarUI(); };
                if (item && item.type > 0 && item.count > 0) {
                    const style = getInventoryIconStyle(item.type);
                    slot.innerHTML = `<div class="block-preview" style="${style}"></div><div class="slot-count">${item.count === Infinity ? '∞' : item.count}</div>`;
                }
                container.appendChild(slot);
            }

            const currentItem = player.inventory[player.selectedIdx];
            const eatBtn = document.getElementById('btn-eat');
            if (currentItem && BLOCK_PROPS[currentItem.type] && BLOCK_PROPS[currentItem.type].foodValue > 0 && currentItem.count > 0 && player.hunger < 10) {
