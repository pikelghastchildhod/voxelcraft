        function updateSky() {
            if (isCutscene) return; 
            
            timeOfDay = (performance.now() % dayDuration) / dayDuration;
            const dayColor = new THREE.Color(0x87CEEB);
            const nightColor = new THREE.Color(0x0a0a1a);
            let skyColor, intensity;
            const t = timeOfDay;
            if (t < 0.2) {
                skyColor = nightColor.clone().lerp(dayColor, t/0.2);
                intensity = 0.2 + (t/0.2) * 0.4;
            } else if (t < 0.5) {
                skyColor = dayColor;
                intensity = 0.6;
            } else if (t < 0.7) {
                skyColor = dayColor.clone().lerp(nightColor, (t-0.5)/0.2);
                intensity = 0.6 - ((t-0.5)/0.2) * 0.4;
            } else {
                skyColor = nightColor;
                intensity = 0.2;
            }

            if (activeShader && activeShader.skyTint) {
                skyColor.lerp(new THREE.Color(activeShader.skyTint), 0.5);
            }

            scene.background = skyColor;
            scene.fog = new THREE.Fog(skyColor, 25, activeShader ? activeShader.fogDistance : 60);
            sun.intensity = intensity;
            const angle = timeOfDay * Math.PI * 2 - Math.PI/2;
            sun.position.set(Math.cos(angle) * 50, Math.sin(angle) * 50, 20);
            const dayNow = Math.floor(performance.now() / dayDuration) + 1;
            if (dayNow !== currentDay) { currentDay = dayNow; document.getElementById('day-clock').innerText = `Day ${currentDay}`; }
        }

        function generateChunkSync(cx, cz) {
            const chunkKey = `${cx},${cz}`;
            if (generatedChunks.has(chunkKey)) return false;
            
            const startX = cx * CHUNK_SIZE, startZ = cz * CHUNK_SIZE;
            
            let biomeType = chunkBiomes.get(chunkKey);
            if (!biomeType) {
                const biomeNoise = noise(cx * 0.32, cz * 0.32); 
                const altNoise = noise(cx * 0.16 + 500, cz * 0.16 + 500);
                
                if (CUSTOM_BIOMES.length > 0 && biomeNoise < 0.15) {
                    let idx = Math.abs(Math.floor(noise(cx, cz) * 100)) % CUSTOM_BIOMES.length;
                    biomeType = "CUSTOM_" + idx;
                }
                else if (biomeNoise > 0.75) biomeType = "DESERT";
                else if (biomeNoise < 0.3) biomeType = "CHERRY";
                else if (altNoise > 0.7) biomeType = "JUNGLE";
                else biomeType = "GRASSLAND";
                
                chunkBiomes.set(chunkKey, biomeType);
            }

            for(let x = startX; x < startX + CHUNK_SIZE; x++) {
                for(let z = startZ; z < startZ + CHUNK_SIZE; z++) {
                    let baseHeight = noise(x * 0.015, z * 0.015) * 15 + 10;
                    let detailHeight = noise(x * 0.06, z * 0.06) * 5;

                    let mountainVal = noise(x * 0.008 + 1000, z * 0.008 + 1000); 
                    let mountainBoost = 0;
                    if (mountainVal > 0.55) {
                        let t = (mountainVal - 0.55) / 0.45; 
                        let peakShape = Math.pow(t, 2.5); 
                        let ruggedness = noise(x * 0.05, z * 0.05) * 35 * t; 
                        mountainBoost = peakShape * 70 + ruggedness; 
                    }

                    const h = Math.floor(baseHeight + detailHeight + mountainBoost);
                    
                    let surfaceType, subType;
                    
                    if (biomeType.startsWith("CUSTOM_")) {
                        const cb = CUSTOM_BIOMES[parseInt(biomeType.split("_")[1])];
                        surfaceType = cb.surfaceBlockId;
                        subType = BLOCK_TYPES[cb.subBlock] || BLOCK_TYPES.DIRT;
                    } 
                    else if (h > 45) { 
                        surfaceType = BLOCK_TYPES.SNOW; 
                        subType = BLOCK_TYPES.SNOW; 
                    } else if (h > 28) { 
                        surfaceType = BLOCK_TYPES.STONE; 
                        subType = BLOCK_TYPES.STONE; 
                    } else {
                        if (biomeType === "DESERT") { surfaceType = BLOCK_TYPES.SAND; subType = BLOCK_TYPES.SANDSTONE; }
                        else if (biomeType === "JUNGLE") { surfaceType = BLOCK_TYPES.JUNGLE_GRASS; subType = BLOCK_TYPES.DIRT; }
                        else if (biomeType === "CHERRY") { surfaceType = BLOCK_TYPES.CHERRY_GRASS; subType = BLOCK_TYPES.DIRT; }
                        else { surfaceType = BLOCK_TYPES.GRASS; subType = BLOCK_TYPES.DIRT; }
                    }

                    for(let y=0; y<=h; y++) {
                        const key = getBlockKey(x,y,z);
                        if (!blocks.has(key)) {
                            if (y === h) blocks.set(key, surfaceType);
                            else if (y > h-3) blocks.set(key, subType);
                            else {
                                if (Math.random() > 0.95) blocks.set(key, BLOCK_TYPES.IRON_ORE);
                                else blocks.set(key, BLOCK_TYPES.STONE);
                            }
                        }
                    }
                    
                    if (h <= 45 && biomeType !== "DESERT" && Math.random() > 0.998) mobs.push(new Chicken(x, h + 1, z));
                    if (h <= 45 && biomeType === "DESERT" && Math.random() > 0.998) mobs.push(new Camel(x, h + 1, z));
                    if (Math.random() > 0.9997) mobs.push(new Zombie(x, h + 1, z));
                    
                    let isFlatTerrain = h <= 28; 
                    
                    if (isFlatTerrain) {
                        if (biomeType.startsWith("CUSTOM_")) {
                            const cb = CUSTOM_BIOMES[parseInt(biomeType.split("_")[1])];
                            if (Math.random() > 0.99) {
                                for(let i=1; i<5; i++) {
                                    const k = getBlockKey(x, h+i, z);
                                    if (!blocks.has(k)) blocks.set(k, BLOCK_TYPES[cb.treeType] || BLOCK_TYPES.WOOD);
                                }
                            }
                        }
                        else if (biomeType === "DESERT" && Math.random() > 0.992) {
                            for(let i=1; i<=(2+Math.random()*2); i++) {
                                const k = getBlockKey(x, h+i, z);
                                if (!blocks.has(k)) blocks.set(k, BLOCK_TYPES.CACTUS);
                            }
                        } else if (biomeType === "GRASSLAND" && Math.random() > 0.995 && h > 6) { 
                            for(let i=1; i<5; i++) {
                                const k = getBlockKey(x, h+i, z);
                                if (!blocks.has(k)) blocks.set(k, BLOCK_TYPES.WOOD);
                            }
                            for(let dx=-2; dx<=2; dx++) for(let dz=-2; dz<=2; dz++) if (Math.abs(dx)+Math.abs(dz) <= 3) {
                                const k = getBlockKey(x+dx, h+5, z+dz);
                                if (!blocks.has(k)) blocks.set(k, BLOCK_TYPES.LEAVES);
                            }
                        } else if (biomeType === "JUNGLE" && Math.random() > 0.985 && h > 8) {
                            const treeHeight = 8 + Math.floor(Math.random() * 6);
                            for(let i=1; i<treeHeight; i++) {
                                const k = getBlockKey(x, h+i, z);
                                if (!blocks.has(k)) blocks.set(k, BLOCK_TYPES.JUNGLE_WOOD);
                            }
                            for(let dy=treeHeight-3; dy<=treeHeight; dy++) {
                                const r = dy === treeHeight ? 1 : 2;
                                for(let dx=-r; dx<=r; dx++) for(let dz=-r; dz<=r; dz++) if (Math.abs(dx)+Math.abs(dz) <= r+1) if (!blocks.has(getBlockKey(x+dx,h+dy,z+dz))) blocks.set(getBlockKey(x+dx,h+dy,z+dz), BLOCK_TYPES.JUNGLE_LEAVES);
                            }
                        } else if (biomeType === "CHERRY" && Math.random() > 0.988 && h > 6) {
                            const treeHeight = 5 + Math.floor(Math.random() * 3);
                            for(let i=1; i<treeHeight; i++) {
                                const k = getBlockKey(x, h+i, z);
                                if (!blocks.has(k)) blocks.set(k, BLOCK_TYPES.CHERRY_WOOD);
                            }
                            for(let dy=treeHeight-2; dy<=treeHeight+1; dy++) {
                                const r = (dy >= treeHeight) ? 1 : 2;
                                for(let dx=-r; dx<=r; dx++) for(let dz=-r; dz<=r; dz++) if (Math.abs(dx)+Math.abs(dz) <= 3) if (!blocks.has(getBlockKey(x+dx,h+dy,z+dz))) blocks.set(getBlockKey(x+dx,h+dy,z+dz), BLOCK_TYPES.CHERRY_LEAVES);
                            }
                        }
                    }
                }
            }
            generatedChunks.add(chunkKey); return true;
        }

        async function generateWorld() {
            const pcx = Math.floor(player.pos.x / CHUNK_SIZE), pcz = Math.floor(player.pos.z / CHUNK_SIZE);
            let total = (RENDER_DISTANCE*2+1)**2, done = 0;
            for (let cx = pcx-RENDER_DISTANCE; cx <= pcx+RENDER_DISTANCE; cx++) {
                for (let cz = pcz-RENDER_DISTANCE; cz <= pcz+RENDER_DISTANCE; cz++) {
                    generateChunkSync(cx, cz); done++;
                    document.getElementById('progress').style.width = (done/total*100)+'%';
                    if (done % 4 === 0) await new Promise(r => setTimeout(r, 1));
                }
            }
            updateScene();
            document.getElementById('loading').style.opacity = '0';
            setTimeout(() => { if (document.getElementById('loading')) document.getElementById('loading').remove(); document.getElementById('menu-overlay').classList.remove('hidden'); }, 400);
        }

        const chunkMeshes = new Map();
        function updateScene(targetCx = null, targetCz = null) {
            const pcx = Math.floor(player.pos.x / CHUNK_SIZE);
            const pcz = Math.floor(player.pos.z / CHUNK_SIZE);
            if (targetCx !== null && targetCz !== null) updateChunk(targetCx, targetCz);
            else {
                const visible = new Set();
                for (let cx = pcx - RENDER_DISTANCE; cx <= pcx + RENDER_DISTANCE; cx++) {
                    for (let cz = pcz - RENDER_DISTANCE; cz <= pcz + RENDER_DISTANCE; cz++) {
                        visible.add(`${cx},${cz}`);
                        if (!generatedChunks.has(`${cx},${cz}`)) generateChunkSync(cx, cz);
                        if (!chunkMeshes.has(`${cx},${cz}`)) updateChunk(cx, cz);
                    }
                }
                chunkMeshes.forEach((meshes, key) => { if (!visible.has(key)) { meshes.forEach(m => { m.geometry.dispose(); worldParent.remove(m); }); chunkMeshes.delete(key); } });
            }
            lastChunkX = pcx; lastChunkZ = pcz;
        }

        function updateChunk(cx, cz) {
            const key = `${cx},${cz}`;
            if (chunkMeshes.has(key)) { chunkMeshes.get(key).forEach(m => { m.geometry.dispose(); worldParent.remove(m); }); }
            const groups = new Map();
            const startX = cx * CHUNK_SIZE, startZ = cz * CHUNK_SIZE;
            for(let x = startX; x < startX + CHUNK_SIZE; x++) {
                for(let z = startZ; z < startZ + CHUNK_SIZE; z++) {
                    for(let y=0; y<60; y++) {
                        const b = getBlock(x,y,z); if (b === 0) continue;
                        if (!groups.has(b)) groups.set(b, []);
                        groups.get(b).push({x, y, z});
                    }
                }
            }
            const dummy = new THREE.Object3D(), meshes = [];
            groups.forEach((list, type) => {
                const mesh = new THREE.InstancedMesh(blockGeometry, getMaterials(type), list.length);
                list.forEach((p, i) => { dummy.position.set(p.x+0.5, p.y+0.5, p.z+0.5); dummy.updateMatrix(); mesh.setMatrixAt(i, dummy.matrix); });
                worldParent.add(mesh); meshes.push(mesh);
            });
            chunkMeshes.set(key, meshes);
        }

        function handleMining() {
            if (!isMining || !isGameStarted || isCraftingOpen || isPlayerDead || isCutscene) return;
            const ray = new THREE.Raycaster(); ray.setFromCamera(new THREE.Vector2(0,0), camera);
            const hit = ray.intersectObjects(worldParent.children)[0];
            if (hit && hit.distance < 5) {
                const matrix = new THREE.Matrix4(); hit.object.getMatrixAt(hit.instanceId, matrix);
                const pos = new THREE.Vector3().setFromMatrixPosition(matrix).subScalar(0.5);
                const tx = Math.floor(pos.x), ty = Math.floor(pos.y), tz = Math.floor(pos.z), type = getBlock(tx, ty, tz), key = getBlockKey(tx, ty, tz);
                if (isCreative) { 
                    if (miningTarget !== key || performance.now() - lastCreativeBreakTime > 200) {
                        blocks.delete(key); updateScene(Math.floor(tx/CHUNK_SIZE), Math.floor(tz/CHUNK_SIZE)); 
                        lastCreativeBreakTime = performance.now(); miningTarget = key;
                    } return; 
                }
                if (miningTarget !== key) { miningTarget = key; miningProgress = 0; }
                
                let eff = 0.5;
                const tool = player.inventory[player.selectedIdx]?.type;
                
                const isWood = [BLOCK_TYPES.WOOD, BLOCK_TYPES.JUNGLE_WOOD, BLOCK_TYPES.CHERRY_WOOD, BLOCK_TYPES.PLANKS].includes(type);
                const isStone = [BLOCK_TYPES.STONE, BLOCK_TYPES.SANDSTONE, BLOCK_TYPES.IRON_ORE].includes(type);
                
                if (isWood) {
                    if (tool === BLOCK_TYPES.AXE) eff = 2.0;
                    else if (tool === BLOCK_TYPES.STONE_AXE) eff = 4.0;
                    else if (tool === BLOCK_TYPES.IRON_AXE) eff = 8.0;
                } else if (isStone) {
                    if (tool === BLOCK_TYPES.PICKAXE) eff = 2.0;
                    else if (tool === BLOCK_TYPES.STONE_PICKAXE) eff = 4.0;
                    else if (tool === BLOCK_TYPES.IRON_PICKAXE) eff = 8.0;
                } else {
                    if ([BLOCK_TYPES.SWORD, BLOCK_TYPES.STONE_SWORD, BLOCK_TYPES.IRON_SWORD].includes(tool)) eff = 0.75;
                    else if ([BLOCK_TYPES.AXE, BLOCK_TYPES.STONE_AXE, BLOCK_TYPES.IRON_AXE].includes(tool) && !isWood) eff = 0.75;
                    else if ([BLOCK_TYPES.PICKAXE, BLOCK_TYPES.STONE_PICKAXE, BLOCK_TYPES.IRON_PICKAXE].includes(tool) && !isStone) eff = 0.75;
                }

                miningProgress += (Date.now() - (lastMiningTime || Date.now())) * eff;
                const hard = BLOCK_PROPS[type]?.hardness || 500;
                
                document.getElementById('break-indicator').style.display = 'block';
                document.getElementById('break-progress').style.width = Math.min(100, (miningProgress/hard)*100) + '%';
                if (miningProgress >= hard) { 
                    blocks.delete(key); addToInventory(type); updateScene(Math.floor(tx/CHUNK_SIZE), Math.floor(tz/CHUNK_SIZE)); miningProgress = 0; document.getElementById('break-indicator').style.display = 'none'; 
                    if(isWood) unlockAchievement('GETTING_WOOD');
                    if(type === BLOCK_TYPES.STONE) unlockAchievement('STONE_AGE');
                }
            } else { miningProgress = 0; document.getElementById('break-indicator').style.display = 'none'; }
        }

        function handleRightClick() {
            if (isCraftingOpen || isPlayerDead || isCutscene) return;
            const item = player.inventory[player.selectedIdx];
            if (!item || item.count <= 0) return;
            
            if (item.type === BLOCK_TYPES.RITUAL && !bossEntity) {
                if(!isCreative) { item.count--; if (item.count === 0) item.type = 0; }
                updateHotbarUI();
                startRitualCutscene();
                return;
            }

            if (BLOCK_PROPS[item.type] && BLOCK_PROPS[item.type].foodValue > 0 && player.hunger < 10) {
                eatMeat();
                return;
            }
            const ray = new THREE.Raycaster(); ray.setFromCamera(new THREE.Vector2(0,0), camera);
            const hit = ray.intersectObjects(worldParent.children)[0];
            if (hit && hit.distance < 5) {
                const matrix = new THREE.Matrix4(); hit.object.getMatrixAt(hit.instanceId, matrix);
                const pos = new THREE.Vector3().setFromMatrixPosition(matrix).subScalar(0.5);
                const normal = hit.face.normal;
                const px = Math.floor(pos.x + normal.x), py = Math.floor(pos.y + normal.y), pz = Math.floor(pos.z + normal.z);
                
                if (!isSolid(px, py, pz) && BLOCK_PROPS[item.type]?.placeable) {
                    blocks.set(getBlockKey(px, py, pz), item.type);
                    if (!isCreative) { item.count--; if (item.count === 0) item.type = 0; }
                    updateScene(Math.floor(px/CHUNK_SIZE), Math.floor(pz/CHUNK_SIZE)); updateHotbarUI();
                }
            }
        }

        // Game Loop
        let lastFrameTime = 0;
        function loop(timestamp) {
            requestAnimationFrame(loop);
            
            try {
                if (!lastFrameTime) lastFrameTime = timestamp || performance.now();
                let dt = ((timestamp || performance.now()) - lastFrameTime) / 16.666;
                lastFrameTime = timestamp || performance.now();
                if (dt > 3) dt = 3; 
                if (dt <= 0) dt = 0.001;

                handleGamepad(dt);

                if (!isGameStarted) { 
                    camera.position.set(32 + Math.cos(performance.now()*0.0003)*20, 35, 32 + Math.sin(performance.now()*0.0003)*20);
                    camera.lookAt(32, 20, 32); updateSky(); renderer.render(scene, camera); return; 
                }
                
                if (isCraftingOpen) { renderer.render(scene, camera); return; }
                
                if (isCutscene) {
                    handleCutsceneEngine(dt);
                    for (let i = mobs.length - 1; i >= 0; i--) { if (mobs[i] && !mobs[i].isDead) mobs[i].update(dt); }
                    if (bossEntity && !bossEntity.isDead) bossEntity.update(dt);
                    renderer.render(scene, camera);
                    return;
                }

                updateSky();
                
                if (!isCreative && !isPlayerDead) {
                    if (lastHungerTick === 0) lastHungerTick = performance.now();
                    if (performance.now() - lastHungerTick > 15000) {
                        player.hunger = Math.max(0, player.hunger - 1);
                        lastHungerTick = performance.now();
                        updateHUD();
                    }
                }

                for (let i = droppedItems.length - 1; i >= 0; i--) {
                    const drop = droppedItems[i];
                    if (!drop || !drop.pos) { droppedItems.splice(i, 1); continue; }
                    const distToPlayer = player.pos.distanceTo(drop.pos);
                    if (!isPlayerDead && distToPlayer < 3.0 && !drop.collected) {
                        const dir = player.pos.clone().sub(drop.pos);
                        if (dir.lengthSq() > 0.001) {
                            dir.normalize().multiplyScalar(0.15 * dt);
                            drop.pos.add(dir);
                        }
                        if (distToPlayer < 0.8) {
                            if (addToInventory(drop.type)) {
                                drop.collected = true;
                                if(drop.mesh) scene.remove(drop.mesh);
                                droppedItems.splice(i, 1);
                                continue;
                            }
                        }
                    } else {
                        drop.vel.y -= 0.01 * dt;
                        drop.pos.add(drop.vel.clone().multiplyScalar(dt));
                        if (isSolid(drop.pos.x, drop.pos.y, drop.pos.z)) { drop.pos.y = Math.ceil(drop.pos.y); drop.vel.y = 0; }
                    }
                    if (drop.mesh) {
                        drop.mesh.position.set(drop.pos.x, drop.pos.y + Math.sin((performance.now() - drop.born) * 0.005) * 0.1, drop.pos.z);
                        drop.mesh.rotation.y += 0.05 * dt;
                    }
                }

                for (let i = mobs.length - 1; i >= 0; i--) {
                    if (!mobs[i]) { mobs.splice(i, 1); continue; }
                    if (mobs[i].isDead) mobs.splice(i, 1);
                    else mobs[i].update(dt);
                }
                if (bossEntity && !bossEntity.isDead) bossEntity.update(dt);

                const pcx = Math.floor(player.pos.x / CHUNK_SIZE), pcz = Math.floor(player.pos.z / CHUNK_SIZE);
                if (pcx !== lastChunkX || pcz !== lastChunkZ) updateScene();
                handleMining(); lastMiningTime = Date.now();

                if (!isPlayerDead) {
                    const isJumping = keys['Space'] || gamepadState.buttons[0];
                    const isSneaking = keys['ShiftLeft'] || keys['ShiftRight'] || gamepadState.buttons[1];

                    if (isFlying) {
                        player.vel.y = 0; 
                        if (isJumping) player.vel.y = 0.2;
                        if (isSneaking) player.vel.y = -0.2;
                    } else player.vel.y = Math.max(player.vel.y - 0.012 * dt, -0.4);

                    const move = new THREE.Vector3();
                    if (isMobileMode) { move.z = touchInput.moveY; move.x = touchInput.moveX; }
                    else {
                        if (keys['KeyW']) move.z -= 1; if (keys['KeyS']) move.z += 1;
                        if (keys['KeyA']) move.x -= 1; if (keys['KeyD']) move.x += 1;
                        if (move.length() > 0) move.normalize();

                        if (Math.abs(gamepadState.moveX) > 0 || Math.abs(gamepadState.moveY) > 0) {
                            move.x = gamepadState.moveX;
                            move.z = gamepadState.moveY;
                            if (move.length() > 1) move.normalize();
                        }
                    }
                    
                    const spd = (isCreative && isFlying) ? player.speed * 2.5 : player.speed;
                    if (move.length() > 0) move.applyAxisAngle(new THREE.Vector3(0,1,0), camera.rotation.y).multiplyScalar(spd * dt);
                    
                    const next = player.pos.clone();
                    next.x += move.x; if (!(isCreative && isFlying) && checkCollision(next)) next.x = player.pos.x;
                    next.z += move.z; if (!(isCreative && isFlying) && checkCollision(next)) next.z = player.pos.z;
                    
                    if (isFlying) next.y += player.vel.y * dt;
                    else {
                        player.onGround = false; next.y += player.vel.y * dt;
                        if (checkCollision(next)) { if (player.vel.y < 0) player.onGround = true; next.y = player.pos.y; player.vel.y = 0; }
                        if (isJumping && player.onGround) { player.vel.y = 0.22; player.onGround = false; }
                    }
                    player.pos.copy(next); 
                } else {
                    player.vel.y = Math.max(player.vel.y - 0.012 * dt, -0.4);
                    player.pos.y += player.vel.y * dt;
                    if (checkCollision(player.pos)) { player.pos.y = Math.ceil(player.pos.y); player.vel.y = 0; }
                }
                
                if (player.pos.y < -10) { player.pos.y = 120; player.vel.y = 0; }
                if (!isFlying && checkCollision(player.pos)) { player.pos.y += 0.5; }

                camera.position.copy(player.pos);
                renderer.render(scene, camera);
            } catch (err) {
                console.error("Game Loop Error:", err);
            }
        }

        window.onresize = () => { camera.aspect = window.innerWidth/window.innerHeight; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth, window.innerHeight); };
        init();
    </script>
