        async function generateAIMod() {
            const promptInput = document.getElementById('mod-prompt').value.trim();
            const modType = document.getElementById('mod-type-select').value;
            if (!promptInput) return;

            const btn = document.getElementById('btn-generate-mod');
            btn.innerText = "GENERATING... (Wait)";
            btn.style.pointerEvents = "none";
            document.getElementById('mod-output-box').innerText = "Consulting the AI Gods...";
            document.getElementById('btn-dl-mod').classList.add('hidden');
            document.getElementById('btn-inst-mod').classList.add('hidden');

            let sysPrompt = "";
            if (modType === "BLOCK_ITEM") {
                sysPrompt = `You are a Mod Generator. Create a JSON for a Block or Item based on: "${promptInput}". Return ONLY valid JSON.
{ "isMod": true, "modType": "BLOCK_ITEM", "id": "UPPERCASE_ID", "displayName": "Name", "isItem": true, "colors": ["#fff", "#fff", "#fff"], "art": ["                ","                ","                ","                ","                ","                ","                ","                ","                ","                ","                ","                ","                ","                ","                ","                "], "pal": {"a":"#hex"}, "hardness": 500, "placeable": false, "foodValue": 0, "damage": 5 }
Rule: art array MUST have exactly 16 strings, each exactly 16 characters long.`;
            } else if (modType === "SHADER") {
                sysPrompt = `You are a Mod Generator. Create a JSON Shader pack based on: "${promptInput}". Return ONLY valid JSON.
{ "isMod": true, "modType": "SHADER", "id": "UPPERCASE_ID", "displayName": "Name", "lightColor": "#ffffff", "ambientIntensity": 0.8, "skyTint": "#hex", "fogDistance": 40 }`;
            } else if (modType === "BIOME") {
                sysPrompt = `You are a Mod Generator. Create a JSON Custom Biome based on: "${promptInput}". Return ONLY valid JSON.
{ "isMod": true, "modType": "BIOME", "id": "UPPERCASE_ID", "displayName": "Name", "surfacePalette": ["#base", "#high", "#shadow"], "subBlock": "DIRT", "treeType": "WOOD" }`;
            } else if (modType === "TEXTURE_PACK") {
                sysPrompt = `You are a Mod Generator. Create a JSON Texture Pack recoloring existing blocks based on: "${promptInput}". Return ONLY valid JSON.
{ "isMod": true, "modType": "TEXTURE_PACK", "id": "UPPERCASE_ID", "displayName": "Name", "overrides": { "GRASS": ["#base", "#high", "#shad"], "DIRT": ["#hex","#hex","#hex"], "STONE": ["#hex","#hex","#hex"], "WOOD": ["#hex","#hex","#hex"], "LEAVES": ["#hex","#hex","#hex"] } }`;
            }

            try {
                const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
                const payload = { contents: [{ parts: [{ text: promptInput }] }], systemInstruction: { parts: [{ text: sysPrompt }] } };
                
                const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                if (!response.ok) throw new Error("HTTP " + response.status);
                const result = await response.json();
                
                let text = result.candidates?.[0]?.content?.parts?.[0]?.text;
                if(!text) throw new Error("No text returned");
                
                const jsonStart = text.indexOf('{');
                const jsonEnd = text.lastIndexOf('}');
                if (jsonStart !== -1 && jsonEnd !== -1) {
                    text = text.substring(jsonStart, jsonEnd + 1);
                }

                const modData = JSON.parse(text);
                if(!modData.isMod) throw new Error("Missing isMod flag");

                generatedModCache = modData;
                document.getElementById('mod-output-box').innerHTML = `<b>Success!</b> Generated: <u>${modData.displayName}</u><br>Type: ${modData.modType}`;
                document.getElementById('btn-dl-mod').classList.remove('hidden');
                document.getElementById('btn-inst-mod').classList.remove('hidden');

            } catch (e) {
                console.error(e);
                document.getElementById('mod-output-box').innerText = "Generation failed. Try a simpler prompt or use a Quick Load example above.";
            }

            btn.innerText = "GENERATE MOD";
            btn.style.pointerEvents = "auto";
        }

