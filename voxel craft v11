        function handleGamepad(dt) {
            const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
            const gp = gamepads[0];
            if (!gp || !isGameStarted || isPaused || isPlayerDead || isCutscene) return;

            const isPressed = (b) => typeof b === "object" ? b.pressed : b === 1.0;
            const getVal = (b) => typeof b === "object" ? b.value : b;
            const applyDeadzone = (val, threshold = 0.15) => Math.abs(val) > threshold ? val : 0;

            if (!isCraftingOpen) {
                const lookX = applyDeadzone(gp.axes[2]);
                const lookY = applyDeadzone(gp.axes[3]);
                if (lookX !== 0 || lookY !== 0) {
                    camera.rotation.y -= lookX * 0.05 * dt;
                    camera.rotation.x = Math.max(-Math.PI/2, Math.min(Math.PI/2, camera.rotation.x - lookY * 0.05 * dt));
                }
            }

            gamepadState.moveX = applyDeadzone(gp.axes[0]);
            gamepadState.moveY = applyDeadzone(gp.axes[1]);

            if (isPressed(gp.buttons[0]) && !gamepadState.buttons[0]) {
                if (!isCraftingOpen) handleJumpPress();
            }
            if (isPressed(gp.buttons[2]) && !gamepadState.buttons[2]) {
                toggleCrafting();
            }
            if (isPressed(gp.buttons[3]) && !gamepadState.buttons[3]) {
                if (!isCraftingOpen) eatMeat();
            }
            if (isPressed(gp.buttons[4]) && !gamepadState.buttons[4]) {
                player.selectedIdx = (player.selectedIdx - 1 + 9) % 9;
                updateHotbarUI();
            }
            if (isPressed(gp.buttons[5]) && !gamepadState.buttons[5]) {
                player.selectedIdx = (player.selectedIdx + 1) % 9;
                updateHotbarUI();
            }

            const rtVal = getVal(gp.buttons[7]);
            if (rtVal > 0.5) {
                if (!gamepadState.rt && !isCraftingOpen) {
                    if (!handleAttack()) { isMining = true; miningProgress = 0; }
                }
                gamepadState.rt = true;
            } else {
                if (gamepadState.rt) {
                    isMining = false; miningProgress = 0; 
                    if (document.getElementById('break-indicator')) document.getElementById('break-indicator').style.display = 'none';
                }
                gamepadState.rt = false;
            }

            const ltVal = getVal(gp.buttons[6]);
            if (ltVal > 0.5) {
                if (!gamepadState.lt && !isCraftingOpen) handleRightClick();
                gamepadState.lt = true;
            } else {
                gamepadState.lt = false;
            }

            for(let i=0; i<gp.buttons.length; i++) gamepadState.buttons[i] = isPressed(gp.buttons[i]);
        }

