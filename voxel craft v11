        function handleCutsceneEngine(dt) {
            cutsceneData.time += dt / 60; 
            const t = cutsceneData.time;

            if (cutsceneData.phase === 0) {
                const targetPos = player.pos.clone().add(new THREE.Vector3(0, 2, 0));
                camera.position.lerp(targetPos, 0.05 * dt);
                
                cutsceneData.targetLook.lerp(cutsceneData.chicken.pos, 0.05 * dt);
                camera.lookAt(cutsceneData.targetLook);

                if (t > 2.0) { cutsceneData.phase = 1; triggerLightning(); }
            } 
            else if (cutsceneData.phase === 1) {
                cutsceneData.chicken.aiState = 'FLEE'; 
                mobs.forEach(m => {
                    if (m instanceof Chicken || m instanceof Camel) m.aiState = 'FLEE';
                });
                if (t > 3.0) { cutsceneData.phase = 2; }
            }
            else if (cutsceneData.phase === 2) {
                cutsceneData.targetLook.lerp(cutsceneData.bossPos, 0.05 * dt);
                camera.lookAt(cutsceneData.targetLook);
                if (t > 5.0) { 
                    cutsceneData.phase = 3; 
                    triggerLightning();
                    bossEntity = new BossMutant(cutsceneData.bossPos.x, cutsceneData.bossPos.y + 10, cutsceneData.bossPos.z);
                }
            }
            else if (cutsceneData.phase === 3) {
                cutsceneData.targetLook.lerp(bossEntity.pos, 0.1 * dt);
                camera.lookAt(cutsceneData.targetLook);
                if (t > 8.0) { cutsceneData.phase = 4; }
            }
            else if (cutsceneData.phase === 4) {
                camera.position.lerp(player.pos, 0.1 * dt);
                
                const returnEuler = cutsceneData.startRot;
                const targetQuat = new THREE.Quaternion().setFromEuler(returnEuler);
                camera.quaternion.slerp(targetQuat, 0.1 * dt);

                if (t > 9.5) {
                    isCutscene = false;
                    setCinematicBorders(false);
                    camera.position.copy(player.pos);
                    camera.rotation.copy(cutsceneData.startRot);
                    if (!isMobileMode) document.body.requestPointerLock?.();
                }
            }
        }

        async function fetchGeminiAdvice(promptText) {
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
            const payload = { contents: [{ parts: [{ text: promptText }] }] };
            let retries = 5;
            let delay = 1000;
            while (retries > 0) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    const result = await response.json();
                    return result.candidates?.[0]?.content?.parts?.[0]?.text || "The mystic advisor remains silent.";
                } catch (e) {
                    retries--;
                    if (retries === 0) return "The advisor's magic faded. Try again later.";
                    await new Promise(r => setTimeout(r, delay));
                    delay *= 2;
                }
            }
        }

