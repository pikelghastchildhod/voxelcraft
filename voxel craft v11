        function applySaveData(data) {
            blocks.clear();
            generatedChunks.clear();
            chunkBiomes.clear();

            data.blocks.forEach(([key, val]) => blocks.set(key, val));
            if (data.generatedChunks) data.generatedChunks.forEach(key => generatedChunks.add(key));
            if (data.chunkBiomes) data.chunkBiomes.forEach(([key, val]) => chunkBiomes.set(key, val));
            
            player.pos.set(data.player.pos.x, data.player.pos.y, data.player.pos.z);
            player.health = data.player.health;
            player.hunger = data.player.hunger;
            
            let loadedInv = data.player.inventory || [];
            while(loadedInv.length < 15) loadedInv.push({type: 0, count: 0});
            player.inventory = loadedInv;
            
            player.selectedIdx = data.player.selectedIdx;
            
            if (data.player.achievements) {
                for (let key in data.player.achievements) {
                    if (ACHIEVEMENTS[key]) ACHIEVEMENTS[key].unlocked = data.player.achievements[key];
                }
            }
            
            currentDay = data.world.day;
            isCreative = data.world.isCreative;

            while(worldParent.children.length > 0) {
                const child = worldParent.children[0];
                child.geometry.dispose();
                worldParent.remove(child);
            }
            chunkMeshes.clear();
            updateScene();
        }

