        function installMod(data) {
            if (!data || !data.isMod) { alert("Invalid Mod Format!"); return; }
            
            if (data.modType === 'SHADER') {
                activeShader = data;
                sun.color.setHex(parseInt(data.lightColor.replace('#','0x')));
                ambient.intensity = data.ambientIntensity;
                unlockAchievement('MODDER');
                alert(`Shader Installed: ${data.displayName}`);
            } 
            else if (data.modType === 'TEXTURE_PACK') {
                for (let k in data.overrides) if(COLORS[k]) COLORS[k] = data.overrides[k];
                Object.keys(materials).forEach(k => delete materials[k]);
                Object.keys(inventoryTextures).forEach(k => delete inventoryTextures[k]);
                activeTexturePack = true;
                
                chunkMeshes.forEach(meshes => meshes.forEach(m => { m.geometry.dispose(); worldParent.remove(m); }));
                chunkMeshes.clear();
                updateScene();
                updateHotbarUI();
                if(isCraftingOpen) renderFullInventoryUI();
                unlockAchievement('MODDER');
                alert(`Texture Pack Installed: ${data.displayName}`);
            } 
            else if (data.modType === 'BIOME') {
                const newId = nextModId++;
                BLOCK_TYPES[data.id + "_SURFACE"] = newId;
                COLORS[data.id + "_SURFACE"] = data.surfacePalette;
                BLOCK_PROPS[newId] = { hardness: 400, placeable: true };
                data.surfaceBlockId = newId;
                CUSTOM_BIOMES.push(data);
                unlockAchievement('MODDER');
                alert(`Biome Installed: ${data.displayName}\nExplore the world to find it!`);
            } 
            else {
                const newId = nextModId++;
                BLOCK_TYPES[data.id] = newId;
                
                if (data.isItem) {
                    ITEM_SPRITES[newId] = { art: data.art, pal: data.pal };
                    BLOCK_PROPS[newId] = { placeable: false, foodValue: data.foodValue || 0 };
                    getItemMaterial(newId); 
                } else {
                    COLORS[data.id] = data.colors || ["#fff", "#ddd", "#bbb"];
                    BLOCK_PROPS[newId] = { hardness: data.hardness || 500, placeable: true };
                    getMaterials(newId); 
                }
                MOD_DATA[newId] = data;
                RECIPES['MOD_' + newId] = { tab: 'MAGIC', name: data.displayName, req: '1 Dirt', i: [{t: BLOCK_TYPES.DIRT, c: 1}], o: {t: newId, c: 1} };
                unlockAchievement('MODDER');
                alert(`Mod Installed: ${data.displayName}!\nYou can craft it in the MAGIC tab for 1 Dirt.`);
                if (isGameStarted && isCraftingOpen) { renderCraftingMenu(); renderFullInventoryUI(); }
            }
        }

